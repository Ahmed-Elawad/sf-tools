# Copy to .env and fill in. Lines starting with # are ignored. .env is git-ignored.

# ---- 1. Token request (POST, application/x-www-form-urlencoded) ----
TOKEN_URL=https://idp.example.com/oauth2/v2.0/token
CLIENT_ID=
CLIENT_SECRET=
SCOPE=api://your-api/.default
GRANT_TYPE=client_credentials

# ---- 2. Token validation ----
# strict (default): verify the JWT signature against the issuer's JWKS and check exp/nbf.
# off: skip (use for opaque, non-JWT tokens).
TOKEN_VALIDATION=strict
# JWKS URL. If blank, it is discovered from the token's "iss" claim via /.well-known/openid-configuration.
JWKS_URI=
# Optional extra check that the "iss" claim matches exactly.
EXPECTED_ISSUER=
# Optional: allowed signing algorithms (default covers RS*, PS*, ES*, EdDSA). HS*/none are always refused.
#TOKEN_ALGS=RS256,ES256
#TOKEN_LEEWAY_SECONDS=60

# ---- 3. Salesforce org (first matching option wins) ----
# a) Raw session: SF_ACCESS_TOKEN + SF_INSTANCE_URL
#SF_ACCESS_TOKEN=
#SF_INSTANCE_URL=https://yourdomain.my.salesforce.com
# b) Connected app client-credentials flow: SF_CLIENT_ID + SF_CLIENT_SECRET (+ SF_LOGIN_URL, use your My Domain URL)
#SF_CLIENT_ID=
#SF_CLIENT_SECRET=
#SF_LOGIN_URL=https://yourdomain.my.salesforce.com
# c) Default: an org already authorized in the Salesforce CLI (`sf org login web -a <alias>`).
#    Leave SF_TARGET_ORG blank to use the CLI's default org.
SF_TARGET_ORG=my-org-alias
SF_API_VERSION=66.0

# ---- 4. Named credentials to update (API/developer names, comma or space separated) ----
NAMED_CREDENTIALS=My_Named_Credential,Another_Named_Credential
# Custom header on the named credential that receives the access token.
HEADER_NAME=authorizationCode
# Optional prefix, e.g. "Bearer " (include the trailing space, quoted).
#HEADER_VALUE_PREFIX="Bearer "
# Output-only keys removed from the GET representation before PUT (rarely needs changing).
#SF_NC_STRIP_KEYS=id,url
#HTTP_TIMEOUT_MS=30000

# ---- 5. Scheduling ----
# Keep running and repeat the whole cycle (new token -> validate -> update) every N minutes.
# Blank or 0 = run once and exit. `--once` on the command line forces a single run.
RUN_INTERVAL_MINUTES=45
# After a failed cycle, retry after this many minutes instead of waiting the full interval.
RETRY_INTERVAL_MINUTES=5

# ---- 6. Process logging and shutdown ----
# Timestamped log file (relative paths are resolved next to the script). Written synchronously so it is
# complete even after a hard crash. Rotated to LOG_FILE.1 when it exceeds LOG_MAX_MB. "none" = console only.
LOG_FILE=logs/sync-named-credential-token.log
LOG_MAX_MB=10
# On SIGINT/SIGTERM/SIGHUP the current cycle gets this long to finish before in-flight requests are aborted.
STOP_GRACE_SECONDS=20
